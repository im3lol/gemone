# Local development environment for the API.
#
# Copy to `apps/api/.env`. This one file serves both consumers:
#   - the Prisma CLI, via prisma.config.ts (migrations, studio)
#   - the api/worker processes, via process.loadEnvFile in development
#
# Never committed. Never read in production, where the container environment
# supplies these directly (ARCHITECTURE.md §19.4).
#
# INFRASTRUCTURE ONLY. Business rules — reward rates, hold periods,
# withdrawal limits, daily limits, fraud thresholds, currencies — belong in
# the database-backed ConfigurationService so an admin can change them without
# a deploy. Putting one here is a P3 violation (§5.1).

NODE_ENV=development
APP_ROLE=api
PORT=3000

# Matches the postgres service in docker-compose.yml.
DATABASE_URL="postgresql://gemone:gemone_dev@localhost:5432/gemone?schema=public"
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT=10

# Matches the redis service in docker-compose.yml. Required, with no default:
# a process that silently falls back to localhost is one that can enqueue into
# the wrong instance.
REDIS_URL="redis://localhost:6379"

# --- Secrets --------------------------------------------------------------
# Both are required, both have no default, and both must be at least 32
# characters — see env.schema.ts. Without them the api, the worker and the
# integration suite all refuse to start, naming these three variables.
#
# The values below are the same development placeholders docker-compose.yml
# falls back to. They are in a public repository, so they are keys everyone
# already has: they exist to make a fresh clone runnable, never to be deployed.
# Generate real ones with `openssl rand -base64 48`.
JWT_SECRET="dev-jwt-secret-change-me-at-least-32-chars"
CLICK_SIGNING_SECRET="dev-click-secret-change-me-at-least-32ch"

# --- Provider credentials -------------------------------------------------
# PROVIDER_<SLUG>_<CREDENTIAL>, resolved by the registry (ARCHITECTURE.md
# §7.2). The mock provider talks to no network, so these authenticate nothing —
# they are what a local postback is signed with. The integration suite sets its
# own values and does not read these.
PROVIDER_MOCK_SECRET=mock-fixture-secret
PROVIDER_MOCK_AFFILIATE_ID=AFF-DEV

# Where the integration suite is allowed to delete from — TODO T81.
#
# Optional, and normally left unset: the suite appends `_test` to whatever
# DATABASE_URL names, creates that database and migrates it on the first run.
# Set this only to point the suite somewhere else. Either way it refuses to run
# against a database whose name does not end in `_test`, because these tests
# call deleteMany() on eleven tables.
# TEST_DATABASE_URL="postgresql://gemone:gemone_dev@localhost:5432/gemone_test?schema=public"

LOG_LEVEL=debug
LOG_PRETTY=true
