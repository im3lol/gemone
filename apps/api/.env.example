# Local development environment for the API.
#
# Copy to `apps/api/.env`. This one file serves both consumers:
#   - the Prisma CLI, via prisma.config.ts (migrations, studio)
#   - the api/worker processes, via process.loadEnvFile in development
#
# Never committed. Never read in production, where the container environment
# supplies these directly (ARCHITECTURE.md §19.4).
#
# INFRASTRUCTURE ONLY. Business rules — reward rates, hold periods,
# withdrawal limits, daily limits, fraud thresholds, currencies — belong in
# the database-backed ConfigurationService so an admin can change them without
# a deploy. Putting one here is a P3 violation (§5.1).

NODE_ENV=development
APP_ROLE=api
PORT=3000

# Matches the postgres service in docker-compose.yml.
DATABASE_URL="postgresql://gemone:gemone_dev@localhost:5432/gemone?schema=public"
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT=10

LOG_LEVEL=debug
LOG_PRETTY=true
