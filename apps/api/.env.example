DATABASE_URL="postgresql://gemone:gemone@localhost:5434/gemone?schema=public"
JWT_ACCESS_SECRET="dev-access-secret-change-me"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
PORT=4000
WEB_ORIGIN="http://localhost:3000"

# Offer providers (milestone 2+3). Presence of the *_APP_ID enables the adapter.
ADGEM_APP_ID="demo-adgem-app"
ADGEM_POSTBACK_SECRET="dev-adgem-secret-change-me"
ADGEM_TRACK_URL="https://api.adgem.com/v1/track"
CPX_APP_ID="demo-cpx-app"
CPX_POSTBACK_SECRET="dev-cpx-secret-change-me"
CPX_TRACK_URL="https://offers.cpx-research.com/index.php"

# Redis (BullMQ payout queue) + withdrawal rules (milestone 5)
REDIS_HOST="localhost"
REDIS_PORT=6379
MIN_WITHDRAWAL_POINTS=5000
LARGE_WITHDRAWAL_POINTS=100000

# Fraud / anti-abuse (milestone 6). IPQS_API_KEY optional; without it VPN detection
# uses the FRAUD_BLOCKED_IPS list. Thresholds below are conservative defaults.
IPQS_API_KEY=""
FRAUD_BLOCKED_IPS="203.0.113.66"
FRAUD_MAX_ACCOUNTS_PER_IP=2
FRAUD_VELOCITY_WINDOW_MIN=10
FRAUD_VELOCITY_POINTS=20000
FRAUD_REVERSAL_WINDOW_H=24
FRAUD_MAX_REVERSALS=3

# Observability (milestone 8). SENTRY_DSN empty = error reporting disabled (still logged).
SENTRY_DSN=""
LOG_LEVEL="info"
NODE_ENV="development"
