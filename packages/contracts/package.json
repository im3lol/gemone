{
  "name": "@gemone/contracts",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.esm.json && node scripts/emit-module-markers.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run test:unit",
    "test:unit": "pnpm run build && node --test test/packaging.test.mjs",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@gemone/tsconfig": "workspace:*",
    "typescript": "^5.9.3"
  }
}
