# Infrastructure configuration ONLY — ARCHITECTURE.md §5.1.
#
# Business rules (reward rates, hold periods, withdrawal limits, daily limits,
# fraud thresholds, currencies) do NOT belong here. They live in the
# database-backed ConfigurationService so an admin can change them without a
# deploy. Adding one of them to this file is a P3 violation.
#
# Copy to .env and adjust. Never commit .env.

NODE_ENV=development

# Which entrypoint this process is: api | worker
APP_ROLE=api

PORT=3000

# --- Database -------------------------------------------------------------
# Required. No default: a process that silently falls back to localhost is a
# process that can write to the wrong database.
DATABASE_URL="postgresql://gemone:gemone_dev@localhost:5432/gemone?schema=public"

# Connections held by THIS process. The cluster-wide ceiling is this value
# multiplied by the number of api + worker replicas, and must stay under the
# database's own max_connections.
DATABASE_POOL_MAX=10

# Seconds to wait for a connection from the pool before giving up.
DATABASE_CONNECT_TIMEOUT=10

# --- Redis ----------------------------------------------------------------
# Queues today (BullMQ), caching and rate limiting later. Required, and with
# no default for the same reason as DATABASE_URL: a scheduled job dispatched
# against a development Redis is a job production never runs.
REDIS_URL="redis://localhost:6379"

# --- Token signing --------------------------------------------------------
# Signs access tokens (HS256 — ARCHITECTURE.md §8.1). Required, with no
# default: a process that invents its own signing key would accept tokens
# nothing else issued, and one that shared a published default would accept
# tokens anyone can forge.
#
# At least 32 characters, enforced by the schema — a short key is
# brute-forceable offline against any captured token, and a token forged with
# a recovered key is indistinguishable from a real one.
#
# REPLACE THIS IN PRODUCTION. The value below is a placeholder that is in a
# public repository, so it is a key everyone already has. Generate a real one
# with: openssl rand -base64 48
JWT_SECRET="change-me-dev-only-not-for-production!!"

# --- Click signing --------------------------------------------------------
# Signs the opaque sub_id handed to providers (ARCHITECTURE.md §19.2).
#
# Separate from JWT_SECRET on purpose: an access token lives 15 minutes, a
# click's attribution window lives 30 days. Rotating this invalidates every
# outstanding click and every conversion still to arrive for them, so it is
# not a key to rotate casually.
CLICK_SIGNING_SECRET="change-me-at-least-32-characters-long!!"

# How many reverse proxies sit in front of this process. Behind Caddy: 1.
# Zero is the safe default — with it enabled, the client IP comes from
# X-Forwarded-For, which any caller can send, and the per-IP click limit
# becomes a limit the attacker chooses the key for.
TRUST_PROXY_HOPS=0

# --- Provider credentials -------------------------------------------------
# ARCHITECTURE.md §7.2 rule 3, §5.1.
#
# Naming convention: PROVIDER_<SLUG>_<CREDENTIAL>, uppercased, hyphens to
# underscores. The registry resolves these by exact name and injects them; an
# adapter never reads the environment itself.
#
# Credentials are environment and NOT configuration: they are secrets, they
# change with a deploy, and a secret in a database row is a secret in every
# backup and every replica. A provider's reward rate and hold period are the
# opposite — those are configuration, set by an admin at runtime.
#
# An enabled provider whose variables are missing does not crash the process:
# it becomes inert, and the startup log names the exact variable to set.
#
# The mock provider talks to no network, so its values authenticate nothing.
PROVIDER_MOCK_SECRET=mock-fixture-secret
PROVIDER_MOCK_AFFILIATE_ID=AFF-DEV

# --- Logging --------------------------------------------------------------
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Human-readable logs for a terminal. MUST be false in production, which
# emits JSON to stdout for the container runtime to collect (§16.1).
LOG_PRETTY=true

# --- web (SvelteKit BFF) --------------------------------------------------
# ARCHITECTURE.md §6.1. These are read by `apps/web`, not by the API.

# Where the API lives on the internal network. No default: a `web` that
# silently pointed at localhost would start cleanly and fail every request.
API_URL="http://localhost:3000"

# The public address this app is served from. SvelteKit rejects form posts
# whose Origin does not match, and behind a reverse proxy the process cannot
# work out its own public address.
ORIGIN="http://localhost:5173"

# --- Public origin --------------------------------------------------------
# Where the user-facing app is reachable. Emails carry links, and a process
# behind Caddy on an internal network cannot work this out for itself.
PUBLIC_APP_URL="http://localhost:5173"

# --- Email delivery -------------------------------------------------------
# Leave SMTP_HOST unset and `notifications` uses the logging provider: links
# appear in the application log and the whole flow is completable without a
# mail account. Set a host and the same interface starts delivering real mail.
#
# Credentials, so environment and never configuration (§5.1). Partial settings
# are rejected at startup rather than failing later inside a retrying queue.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="gemone <no-reply@example.com>"
